# Copy this file to .env.docker and choose a private password before first start.
APP_PORT=9000
APP_BIND_IP=127.0.0.1
APP_URL=http://127.0.0.1:9000
APP_TIMEZONE=Asia/Ho_Chi_Minh
DB_BACKUP_RETENTION=30

ADMIN_NAME="Quản trị viên"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PROPERTY_CODE=441
PROPERTY_NAME="Nhà trọ 441 BPL"
PROPERTY_ADDRESS=

# Optional: provide a stable Laravel key yourself. When blank, Docker creates and
# stores one in the persistent app-data volume on first start.
DOCKER_APP_KEY=
