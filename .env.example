# Cấu hình local. Copy thành .env và đặt ADMIN_PASSWORD trước lần chạy đầu.
APP_NAME="Nhà trọ 441 BPL"
APP_ENV=local
APP_DEBUG=false
APP_PORT=15400
APP_BIND_IP=127.0.0.1
APP_URL=http://127.0.0.1:15400
# Bật riêng khi dùng ngrok trên máy này; để trống cho local thông thường.
TRUSTED_PROXIES=
APP_KEY=
# Để trống: Docker tạo và giữ key trong volume app-data.
DOCKER_APP_KEY=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

ADMIN_NAME="Quản trị viên"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PROPERTY_CODE=441
PROPERTY_NAME="Nhà trọ 441 BPL"
PROPERTY_ADDRESS=

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_BACKUP_PATH=storage/app/backups
DB_BACKUP_RETENTION=30

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=log
VITE_PORT=15430
